#!/usr/bin/env python3
"""Validate guidance frontmatter, placement, and required document sections."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

from guidance_contract import (
    REQUIRED_HEADINGS,
    REPOSITORY_ROOT,
    guidance_documents,
    lifecycle_issues,
    parse_frontmatter,
)

RUMDL_RUNNER = REPOSITORY_ROOT / "scripts" / "rumdl"
RUMDL_CONFIG = REPOSITORY_ROOT / ".rumdl.toml"


def level_two_sections(lines: list[str]) -> dict[str, list[str]]:
    sections: dict[str, list[str]] = {}
    current_heading: str | None = None
    fence_character: str | None = None
    fence_length = 0

    for line in lines:
        if fence_character is None:
            fence = re.match(r"^\s*(`{3,}|~{3,})", line)
            if fence is not None:
                marker = fence.group(1)
                fence_character = marker[0]
                fence_length = len(marker)
                continue
        else:
            closing_fence = re.fullmatch(
                rf"\s*{re.escape(fence_character)}{{{fence_length},}}\s*", line
            )
            if closing_fence is not None:
                fence_character = None
                fence_length = 0
            continue

        heading = re.fullmatch(r"## (.+)", line)
        if heading is not None:
            current_heading = heading.group(1).strip()
            sections.setdefault(current_heading, [])
        elif current_heading is not None:
            sections[current_heading].append(line)

    return sections


def validate_document(path: Path, allowed_statuses: set[str]) -> list[str]:
    lines = path.read_text(encoding="utf-8").splitlines()
    fields, body_start, errors = parse_frontmatter(lines)

    status = fields.get("status")
    errors.extend(lifecycle_issues(fields, allowed_statuses))

    body_lines = lines[body_start:]
    first_content = next((line for line in body_lines if line), "")
    if not first_content.startswith("# "):
        errors.append("body must begin with a level-one title")

    if any(line.startswith("**Status:**") for line in body_lines):
        errors.append("body must not duplicate frontmatter status")

    sections = level_two_sections(body_lines)
    if status in REQUIRED_HEADINGS:
        for required_heading in REQUIRED_HEADINGS[status]:
            if required_heading not in sections:
                errors.append(
                    f"status {status!r} requires heading '## {required_heading}'"
                )

    return errors


def main() -> int:
    documents = guidance_documents()
    failures: list[tuple[Path, list[str]]] = []

    for path, allowed_statuses in documents:
        errors = validate_document(path, allowed_statuses)
        if errors:
            failures.append((path, errors))

    if failures:
        for path, errors in failures:
            relative_path = path.relative_to(REPOSITORY_ROOT)
            for error in errors:
                print(f"{relative_path}: {error}", file=sys.stderr)
        return 1

    regression_tests = subprocess.run(
        [sys.executable, REPOSITORY_ROOT / "scripts" / "test_guidance.py"],
        cwd=REPOSITORY_ROOT,
        check=False,
    )
    if regression_tests.returncode:
        return regression_tests.returncode

    print(f"Validated {len(documents)} guidance documents.", flush=True)
    markdown_lint = subprocess.run(
        [
            RUMDL_RUNNER,
            "check",
            "--config",
            RUMDL_CONFIG,
            "--deny-config-warnings",
            ".",
        ],
        cwd=REPOSITORY_ROOT,
        check=False,
    )
    return markdown_lint.returncode


if __name__ == "__main__":
    raise SystemExit(main())
