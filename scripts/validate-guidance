#!/usr/bin/env python3
"""Validate guidance frontmatter, placement, and required document sections."""

from __future__ import annotations

import re
import sys
from pathlib import Path


REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
ACTIVE_AREAS = ("architecture", "libraries", "practices", "stacks")
ALLOWED_FRONTMATTER_FIELDS = {"status"}
REQUIRED_HEADINGS = {
    "accepted": ("Decision", "Revisit when"),
    "draft": (
        "Tentative preference",
        "Why this is uncertain",
        "Promotion questions",
        "If accepted",
    ),
    "deprecated": ("Replacement", "Rationale"),
}


def guidance_documents() -> list[tuple[Path, set[str]]]:
    documents: list[tuple[Path, set[str]]] = []

    for area in ACTIVE_AREAS:
        for path in sorted((REPOSITORY_ROOT / area).rglob("*.md")):
            if path.name != "README.md":
                documents.append((path, {"accepted", "deprecated"}))

    for path in sorted((REPOSITORY_ROOT / "draft").rglob("*.md")):
        if path.name != "README.md":
            documents.append((path, {"draft"}))

    return documents


def parse_frontmatter(lines: list[str]) -> tuple[dict[str, str], int, list[str]]:
    errors: list[str] = []
    if not lines or lines[0] != "---":
        return {}, 0, ["must begin with YAML frontmatter"]

    try:
        closing_index = lines.index("---", 1)
    except ValueError:
        return {}, 0, ["frontmatter is missing its closing delimiter"]

    fields: dict[str, str] = {}
    for line_number, line in enumerate(lines[1:closing_index], start=2):
        if not line:
            continue

        match = re.fullmatch(r"([a-z][a-z0-9_-]*): ([a-z][a-z0-9_-]*)", line)
        if match is None:
            errors.append(f"line {line_number}: unsupported frontmatter syntax")
            continue

        key, value = match.groups()
        if key in fields:
            errors.append(f"line {line_number}: duplicate frontmatter field {key!r}")
            continue
        fields[key] = value

    unknown_fields = sorted(fields.keys() - ALLOWED_FRONTMATTER_FIELDS)
    if unknown_fields:
        errors.append(f"unknown frontmatter fields: {', '.join(unknown_fields)}")

    return fields, closing_index + 1, errors


def level_two_sections(lines: list[str]) -> dict[str, list[str]]:
    sections: dict[str, list[str]] = {}
    current_heading: str | None = None
    fence_character: str | None = None
    fence_length = 0

    for line in lines:
        if fence_character is None:
            fence = re.match(r"^\s*(`{3,}|~{3,})", line)
            if fence is not None:
                marker = fence.group(1)
                fence_character = marker[0]
                fence_length = len(marker)
                continue
        else:
            closing_fence = re.fullmatch(
                rf"\s*{re.escape(fence_character)}{{{fence_length},}}\s*", line
            )
            if closing_fence is not None:
                fence_character = None
                fence_length = 0
            continue

        heading = re.fullmatch(r"## (.+)", line)
        if heading is not None:
            current_heading = heading.group(1).strip()
            sections.setdefault(current_heading, [])
        elif current_heading is not None:
            sections[current_heading].append(line)

    return sections


def validate_document(path: Path, allowed_statuses: set[str]) -> list[str]:
    lines = path.read_text(encoding="utf-8").splitlines()
    fields, body_start, errors = parse_frontmatter(lines)

    status = fields.get("status")
    if status is None:
        errors.append("frontmatter must define status")
    elif status not in REQUIRED_HEADINGS:
        errors.append(f"unknown status {status!r}")
    elif status not in allowed_statuses:
        expected = ", ".join(sorted(allowed_statuses))
        errors.append(f"status {status!r} is invalid at this path; expected {expected}")

    body_lines = lines[body_start:]
    first_content = next((line for line in body_lines if line), "")
    if not first_content.startswith("# "):
        errors.append("body must begin with a level-one title")

    if any(line.startswith("**Status:**") for line in body_lines):
        errors.append("body must not duplicate frontmatter status")

    sections = level_two_sections(body_lines)
    if status in REQUIRED_HEADINGS:
        for required_heading in REQUIRED_HEADINGS[status]:
            if required_heading not in sections:
                errors.append(
                    f"status {status!r} requires heading '## {required_heading}'"
                )

    if status == "deprecated":
        if "Replacement" in sections:
            replacement = "\n".join(sections["Replacement"])
            if re.search(r"\[[^\]]+\]\([^)]+\)", replacement) is None:
                errors.append("deprecated guidance must link to its replacement")

    return errors


def main() -> int:
    documents = guidance_documents()
    failures: list[tuple[Path, list[str]]] = []

    for path, allowed_statuses in documents:
        errors = validate_document(path, allowed_statuses)
        if errors:
            failures.append((path, errors))

    if failures:
        for path, errors in failures:
            relative_path = path.relative_to(REPOSITORY_ROOT)
            for error in errors:
                print(f"{relative_path}: {error}", file=sys.stderr)
        return 1

    print(f"Validated {len(documents)} guidance documents.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
